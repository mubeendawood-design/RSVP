NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only — never expose to the browser, never prefix with NEXT_PUBLIC_.
# Used by /api/host/create to bypass RLS as the host. Copy from Supabase
# Settings → API → "service_role" key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Stopgap gate for /host/* — pick any password, share it only with yourself.
# Phone-verified host auth replaces this later.
HOST_PASSWORD=choose-a-password
